{% comment %}
  Visitor counter backed by the free Abacus API (https://abacus.jasoncameron.dev).
  - Each browser is counted once per day (key "day-YYYY-MM-DD", Champaign time)
    and once ever (key "total-visitors"). Only the live domain is counted.
  - The eye button in the navbar opens a panel with the total, today's count,
    and the last 30 days. Finished days are cached in localStorage, and the
    first load is split into two batches to stay under Abacus's limit of
    30 requests per 10 seconds per IP.
{% endcomment %}
<script>
  (function () {
    var API = 'https://abacus.jasoncameron.dev';
    var NS = 'jacob20030316-crypto.github.io';
    var LIVE_HOST = 'jacob20030316-crypto.github.io';
    var TZ = 'America/Chicago';
    var DAYS = 30;

    function dayKey(date) {
      // en-CA formats as YYYY-MM-DD
      return new Intl.DateTimeFormat('en-CA', { timeZone: TZ, year: 'numeric', month: '2-digit', day: '2-digit' }).format(date);
    }
    function store(k, v) {
      try {
        if (v === undefined) return localStorage.getItem(k);
        localStorage.setItem(k, v);
      } catch (e) {
        return null;
      }
    }
    var today = dayKey(new Date());

    // ---- Count this visit ------------------------------------------------
    if (location.hostname === LIVE_HOST) {
      if (store('dw-visit-day') !== today) {
        fetch(API + '/hit/' + NS + '/day-' + today)
          .then(function (r) {
            if (r.ok) store('dw-visit-day', today);
          })
          .catch(function () {});
      }
      if (!store('dw-visited')) {
        fetch(API + '/hit/' + NS + '/total-visitors')
          .then(function (r) {
            if (r.ok) store('dw-visited', '1');
          })
          .catch(function () {});
      }
    }

    // ---- Read counts -----------------------------------------------------
    var cache = {};
    try {
      cache = JSON.parse(store('dw-visit-cache') || '{}');
    } catch (e) {}
    function getCount(key) {
      return fetch(API + '/get/' + NS + '/' + key)
        .then(function (r) {
          if (r.status === 404) return 0;
          if (!r.ok) throw new Error(r.status);
          return r.json().then(function (j) {
            return j.value || 0;
          });
        });
    }

    // ---- Panel -------------------------------------------------------------
    var box, built = false, loading = false;
    function build() {
      box = document.createElement('div');
      box.className = 'photo-lightbox visitor-lightbox';
      box.setAttribute('role', 'dialog');
      box.setAttribute('aria-modal', 'true');
      box.setAttribute('aria-label', 'Visitor stats');
      box.innerHTML =
        '<button class="lightbox-close" type="button" aria-label="Close"><i class="fa-solid fa-xmark"></i></button>' +
        '<div class="visitor-panel">' +
        '<div class="vp-head"><i class="fa-regular fa-eye"></i><span>Visitors</span></div>' +
        '<div class="vp-stats">' +
        '<div><span class="vp-num" data-vp="total">–</span><span class="vp-label">all time</span></div>' +
        '<div><span class="vp-num" data-vp="today">–</span><span class="vp-label">today</span></div>' +
        '</div>' +
        '<div class="vp-chart" aria-hidden="true"></div>' +
        '<div class="vp-axis"><span></span><span class="vp-hover">Last 30 days</span><span>Today</span></div>' +
        '</div>';
      document.body.appendChild(box);
      box.addEventListener('click', function (e) {
        if (!e.target.closest('.visitor-panel') || e.target.closest('.lightbox-close')) close();
      });
      var chart = box.querySelector('.vp-chart');
      // walk back calendar days from today (noon UTC avoids DST edge cases)
      var p = today.split('-');
      for (var i = DAYS - 1; i >= 0; i--) {
        var d = new Date(Date.UTC(+p[0], +p[1] - 1, +p[2] - i, 12));
        var bar = document.createElement('span');
        bar.className = 'vp-bar pending';
        bar.dataset.day = d.toISOString().slice(0, 10);
        bar.dataset.label = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
        if (i === 0) bar.classList.add('is-today');
        chart.appendChild(bar);
      }
      box.querySelector('.vp-axis span').textContent = chart.firstChild.dataset.label;
      var hover = box.querySelector('.vp-hover');
      chart.addEventListener('mouseover', function (e) {
        var b = e.target.closest('.vp-bar');
        if (!b || b.classList.contains('pending')) return;
        var n = +b.dataset.value;
        hover.textContent = b.dataset.label + ' · ' + n + (n === 1 ? ' visitor' : ' visitors');
      });
      chart.addEventListener('mouseleave', function () {
        hover.textContent = 'Last 30 days';
      });
      built = true;
    }

    function render() {
      var bars = box.querySelectorAll('.vp-bar');
      var max = 1;
      bars.forEach(function (b) {
        if (b.dataset.value) max = Math.max(max, +b.dataset.value);
      });
      bars.forEach(function (b) {
        if (!b.dataset.value) return;
        b.classList.remove('pending');
        b.style.height = Math.max(4, (+b.dataset.value / max) * 100) + '%';
      });
    }

    function setBar(day, value) {
      var b = box.querySelector('.vp-bar[data-day="' + day + '"]');
      if (b) b.dataset.value = value;
    }

    function load() {
      if (loading) return;
      loading = true;
      var jobs = [];
      jobs.push(
        getCount('total-visitors').then(function (v) {
          box.querySelector('[data-vp="total"]').textContent = v;
        })
      );
      jobs.push(
        getCount('day-' + today).then(function (v) {
          box.querySelector('[data-vp="today"]').textContent = v;
          setBar(today, v);
        })
      );
      // finished days: use the cache, fetch the rest (most recent first)
      var missing = [];
      box.querySelectorAll('.vp-bar').forEach(function (b) {
        var day = b.dataset.day;
        if (day === today) return;
        if (cache[day] !== undefined) setBar(day, cache[day]);
        else missing.unshift(day);
      });
      render();
      function fetchDays(days) {
        return Promise.all(
          days.map(function (day) {
            return getCount('day-' + day)
              .then(function (v) {
                cache[day] = v;
                setBar(day, v);
              })
              .catch(function () {});
          })
        ).then(function () {
          store('dw-visit-cache', JSON.stringify(cache));
          render();
        });
      }
      var first = missing.slice(0, 20), rest = missing.slice(20);
      Promise.all(jobs.concat(fetchDays(first)))
        .catch(function () {})
        .then(function () {
          render();
          if (!rest.length) {
            loading = false;
            return;
          }
          setTimeout(function () {
            fetchDays(rest).then(function () {
              loading = false;
            });
          }, 10500);
        });
    }

    function open() {
      if (!built) build();
      box.classList.add('open');
      document.documentElement.style.overflow = 'hidden';
      load();
    }
    function close() {
      box.classList.remove('open');
      document.documentElement.style.overflow = '';
    }
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && box) close();
    });
    document.addEventListener('DOMContentLoaded', function () {
      var btn = document.getElementById('visitor-toggle');
      if (btn) btn.addEventListener('click', open);
    });
  })();
</script>
